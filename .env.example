# Alpaca PAPER credentials (never commit real values)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
TRADING_MODE=PAPER
# OBSERVE = everything live, no orders reach Alpaca. PAPER = paper orders (needs `arm`).
EXECUTION_MODE=OBSERVE
STRATEGY_VERSION=newswave_v1.0
DATA_DIR=./data
# The classifier uses the local `claude` CLI login (no ANTHROPIC_API_KEY needed).
# If ANTHROPIC_API_KEY is set it is stripped from the classifier subprocess.
# Blank = auto-detect `claude` on PATH.
CLAUDE_BIN=
